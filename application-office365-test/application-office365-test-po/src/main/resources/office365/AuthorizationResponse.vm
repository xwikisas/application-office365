## A form sending, to the Office365.OAuth page, the authorization response passed in the query string, the way
## Microsoft Entra ID sends it back after the user logs in or cancels. See Office365TestUtils, which wraps it in a
## velocity macro.
{{html clean="false"}}
<form id="authorizationResponse" method="post" action="$xwiki.getURL('Office365.OAuth')">
#foreach ($name in $request.parameterNames)
<label>$escapetool.xml($name)
<input type="text" name="$escapetool.xml($name)" value="$!escapetool.xml($request.getParameter($name))"/></label>
#end
<input type="submit" value="Send"/>
</form>
{{/html}}
